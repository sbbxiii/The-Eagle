# hw definition file for The Eagle FC Rev 1.0 (STM32F405RGT6)
# Designed for the X525 Quadcopter Research Testbed

MCU STM32F4xx STM32F405xx

# Board ID for firmware load
APJ_BOARD_ID 1055

# Use Internal 16 MHz HSI Oscillator (Match Eagle FC hardware)
OSCILLATOR_HZ 0

define STM32_ST_USE_TIMER 5
define CH_CFG_ST_RESOLUTION 16

FLASH_SIZE_KB 1024
FLASH_RESERVE_START_KB 0

# Only one I2C bus: I2C1 on PB6/PB7
I2C_ORDER I2C1
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

# Order of UARTs (and USB)
# SERIAL0 = USB CDC
# SERIAL1 = USART1 (J404 Companion Bridge -> ESP32)
# SERIAL2 = USART6 (RC Receiver)
SERIAL_ORDER OTG1 USART1 USART6

# ADC Battery Sensing
PA1 BAT_VOLT_SENS ADC1 SCALE(1)
PA0 BAT_CURR_SENS ADC1 SCALE(1)
define HAL_BATT_VOLT_PIN 1
define HAL_BATT_CURR_PIN 0
define HAL_BATT_VOLT_SCALE 11.0
define HAL_BATT_CURR_SCALE 17.0

# USB CDC (Disable VBUS sensing on PA9 because PA9 is J404 telemetry)
define BOARD_OTG_NOVBUSSENS
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# USART1 (Telemetry Port J404)
PA9  USART1_TX USART1
PA10 USART1_RX USART1

# USART6 (RC Receiver Port)
PC6 USART6_TX USART6
PC7 USART6_RX USART6

# Status LED (PC8) - Active High
PC8 LED_BLUE OUTPUT LOW GPIO(0)
define HAL_GPIO_A_LED_PIN 0
define HAL_GPIO_B_LED_PIN 1
define HAL_LED_ON 1

# Quad-X Motor PWM Outputs
# Motor 1 (Rear Right) - PB0 (TIM3_CH3)
# Motor 2 (Front Right) - PB1 (TIM3_CH4)
# Motor 3 (Rear Left) - PA2 (TIM2_CH3)
# Motor 4 (Front Left) - PA3 (TIM2_CH4)
PB0 TIM3_CH3 TIM3 PWM(1) GPIO(50)
PB1 TIM3_CH4 TIM3 PWM(2) GPIO(51)
PA2 TIM2_CH3 TIM2 PWM(3) GPIO(52)
PA3 TIM2_CH4 TIM2 PWM(4) GPIO(53)

# IMU: Invensense MPU-9250 on I2C1 address 0x68
IMU Invensense I2C:0:0x68 ROTATION_NONE

# Barometer: BMP388 on I2C1 address 0x76 (fallback 0x77)
BARO BMP388 I2C:0:0x76
BARO BMP388 I2C:0:0x77
define AP_BARO_BMP388_ENABLED 1

# Compass: Allow arming without compass for benchtop bringup
define ALLOW_ARM_NO_COMPASS
define HAL_PROBE_EXTERNAL_I2C_COMPASSES
define HAL_I2C_INTERNAL_MASK 0

# Flash storage setup (Parameter Storage in Sectors 10 & 11: 768KB - 1024KB)
define HAL_STORAGE_SIZE 15360
STORAGE_FLASH_PAGE 10

# Low flash optimizations for 1MB STM32F405
include ../include/save_some_flash.inc
include ../include/minimize_features.inc
include ../include/no_bootloader_DFU.inc
